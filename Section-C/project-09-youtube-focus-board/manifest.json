{
  "manifest_version": 3,
  "name": "YouTube Focus Board",
  "version": "1.0",
  "description": "Maintain focus, track study time, and take timestamped notes on YouTube.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}